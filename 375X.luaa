--[[ 375X Auto-Garde ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- ====== CONFIG ======
local CONFIG = {
    Rayon = 20,              -- Distance de détection (studs)
    Touche = Enum.KeyCode.E, -- Touche de garde du jeu
    Cooldown = 0.15,         -- Temps entre chaque garde
    Actif = true,
}

-- ====== FONCTION DE GARDE ======
local function garder()
    VirtualInputManager:SendKeyEvent(true, CONFIG.Touche, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, CONFIG.Touche, false, game)
end

-- ====== DÉTECTION DES JOUEURS PROCHES ======
local function joueursProches()
    local char = LocalPlayer.Character
    if not char then return {} end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then return {} end
    
    local proches = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local tchar = player.Character
        if not tchar then continue end
        local thrp = tchar:FindFirstChild("HumanoidRootPart")
        if not thrp then continue end
        
        local dist = (myHRP.Position - thrp.Position).Magnitude
        if dist <= CONFIG.Rayon then
            table.insert(proches, player)
        end
    end
    return proches
end

-- ====== BOUCLE PRINCIPALE ======
local dernierGarde = 0

RunService.Heartbeat:Connect(function()
    if not CONFIG.Actif then return end
    if tick() - dernierGarde < CONFIG.Cooldown then return end
    
    local proches = joueursProches()
    if #proches > 0 then
        dernierGarde = tick()
        garder()
    end
end)

print("[375X] Auto-Garde activé !")
